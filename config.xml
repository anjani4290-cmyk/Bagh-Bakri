<?xml version='1.0' encoding='utf-8'?>
<widget id="com.yourname.baghbakri" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Bagh Bakri</name>
    <description>
        A classic two-player strategy board game. Capture all of the
        opponent's pieces to win. Play with a friend on one device, or
        against the built-in computer opponent.
    </description>
    <author email="you@example.com" href="https://example.com">
        Your Name
    </author>

    <!--
        Cordova serves everything under www/ as the app's web content.
        This project keeps its source at the repo root, so when you
        run `cordova create`, copy (or symlink) index.html, src/,
        assets/, images/, sounds/ and lib/ into that project's www/
        folder before building. See README.md for the exact steps.
    -->
    <content src="index.html" />

    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <icon density="hdpi" src="assets/android/icon-hdpi.png"/>
        <preference name="AndroidXEnabled" value="true" />
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>

    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="BackgroundColor" value="0xff191009" />
</widget>
